# AI used for document extraction.
# a) OpenAI-compatible gateway (default). Use the standard URL .../jpe - the semantic cache .../jpe/v2
#    replays earlier answers, which breaks the chat agent's tool loop.
LLM_PROVIDER=openai
LLM_BASE_URL=https://aiportalapi.stu-platform.live/jpe
LLM_API_KEY=
LLM_MODEL=DeepSeek-V4.1-Flash
# b) Claude: set LLM_PROVIDER=anthropic and ANTHROPIC_API_KEY
# ANTHROPIC_API_KEY=

# Jira MCP server - set ONE of the two.
# a) stdio server launched by the agent (sooperset/mcp-atlassian):
JIRA_MCP_COMMAND=uvx mcp-atlassian
JIRA_URL=https://your-company.atlassian.net
JIRA_USERNAME=you@company.com
JIRA_API_TOKEN=
# b) remote Streamable-HTTP MCP server:
# JIRA_MCP_URL=https://mcp.example.com/mcp
# JIRA_MCP_TOKEN=

# Storage
DATABASE_URL=sqlite:///data/app.db
CHROMA_DIR=data/chroma
# Embeddings for vector lookup
#   openai = STU gateway (same key as the LLM) | hf = local Hugging Face model, no key | auto = gateway if a key exists
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# HF_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Vector store: chroma (local) or pinecone (cloud, needs PINECONE_API_KEY)
VECTOR_BACKEND=chroma
# Retry policy for every LLM / embedding call
LLM_MAX_RETRIES=4

# Pinecone (VECTOR_BACKEND=pinecone; the notebook uses it when the key is set)
# PINECONE_API_KEY=
# PINECONE_INDEX=delivery-agent
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1

# Text-to-speech for "read the plan aloud" (Hugging Face, runs locally)
# TTS_MODEL=facebook/mms-tts-vie
